{
  "name": "@kikiutils/nuxt",
  "type": "module",
  "version": "16.0.1",
  "description": "Nuxt module.",
  "author": "kiki-kanri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kikiutils/nuxt.git"
  },
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "./dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "bumplog": "changelogen --bump --hideAuthorEmail",
    "dev": "pnpm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "knip:deps": "knip --dependencies",
    "knip:exports": "knip --exports",
    "lint": "eslint --cache --concurrency=auto --max-warnings 0 && stylelint './**/*.{css,scss,vue}' -i ./.gitignore --cache --max-warnings 0",
    "lint:fix": "eslint --cache --concurrency=auto --fix --max-warnings 0 && stylelint './**/*.{css,scss,vue}' -i ./.gitignore --cache --fix --max-warnings 0",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && changelogen --clean --hideAuthorEmail --push --release && npm publish",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "typecheck": "vue-tsc --noEmit && nuxt typecheck ./playground"
  },
  "peerDependencies": {
    "@element-plus/nuxt": "^1.2.0",
    "@kikiutils/shared": "^21.0.0",
    "@nuxt/icon": "^2.6.3",
    "@nuxtjs/color-mode": "^4.1.0",
    "@nuxtjs/robots": "^7.0.2",
    "@unocss/nuxt": "^66.13.0",
    "nuxt": "^4.6.4",
    "nuxt-security": "^2.7.0",
    "nuxt-site-config": "^5.0.3",
    "unplugin-fonts": "^2.1.0"
  },
  "peerDependenciesMeta": {
    "@element-plus/nuxt": {
      "optional": true
    },
    "@kikiutils/shared": {
      "optional": true
    },
    "@nuxt/icon": {
      "optional": true
    },
    "@nuxtjs/color-mode": {
      "optional": true
    },
    "@nuxtjs/robots": {
      "optional": true
    },
    "@unocss/nuxt": {
      "optional": true
    },
    "nuxt-security": {
      "optional": true
    },
    "nuxt-site-config": {
      "optional": true
    },
    "unplugin-fonts": {
      "optional": true
    }
  },
  "dependencies": {
    "@nuxt/kit": "^4.7.0",
    "@vueuse/nuxt": ">=15.0.0",
    "defu": "^6.1.7",
    "ts-extras": "^3.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@element-plus/nuxt": "^1.2.0",
    "@kikiutils/eslint-config": "^11.4.0",
    "@kikiutils/shared": "^21.0.0",
    "@kikiutils/stylelint-config": "^0.7.0",
    "@nuxt/icon": "^2.6.3",
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/schema": "^4.7.0",
    "@nuxt/test-utils": "^4.4.0",
    "@nuxtjs/color-mode": "^4.1.0",
    "@nuxtjs/robots": "^7.1.0",
    "@types/node": "^26.6.6",
    "@unocss/nuxt": "^66.13.0",
    "@vitest/coverage-v8": "^5.1.1",
    "changelogen": "^0.6.2",
    "eslint": "^10.15.0",
    "knip": "^6.48.0",
    "nuxt": "^4.7.0",
    "nuxt-security": "^2.7.0",
    "nuxt-site-config": "^5.0.4",
    "stylelint": "^18.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "unplugin-fonts": "^2.1.0",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
