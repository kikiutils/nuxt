{
  "name": "@kikiutils/nuxt",
  "type": "module",
  "version": "13.0.0",
  "description": "Nuxt module.",
  "author": "kiki-kanri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kikiutils/nuxt.git"
  },
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "./dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "bumplog": "changelogen --bump --hideAuthorEmail",
    "dev": "pnpm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "knip:deps": "knip --dependencies",
    "knip:exports": "knip --exports",
    "lint": "eslint --max-warnings 0 && stylelint './**/*.{css,scss,vue}' -i ./.gitignore --mw 0",
    "lint:fix": "eslint --fix --max-warnings 0 && stylelint './**/*.{css,scss,vue}' -i ./.gitignore --fix --mw 0",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && changelogen --hideAuthorEmail --push --release && npm publish",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "typecheck": "vue-tsc --noEmit && nuxt typecheck ./playground"
  },
  "peerDependencies": {
    "@element-plus/nuxt": "^1.1.5",
    "@kikiutils/shared": "^19.0.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/robots": "^7.0.2",
    "@unocss/nuxt": "^66.11.0",
    "@vueuse/nuxt": "^15.0.0",
    "nuxt": "^4.6.2",
    "nuxt-security": "^2.6.0",
    "type-fest": "^5.10.0",
    "unplugin-fonts": "^2.1.0"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@element-plus/nuxt": "^1.1.5",
    "@eslint/css": "^2.0.1",
    "@html-eslint/parser": "^0.67.0",
    "@kikiutils/eslint-config": "^9.3.1",
    "@kikiutils/eslint-plugin-vue": "^10.10.0",
    "@kikiutils/shared": "^19.0.0",
    "@kikiutils/stylelint-config": "^0.6.1",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.2",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/robots": "^7.0.2",
    "@types/node": "^26.6.5",
    "@unocss/nuxt": "^66.11.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vueuse/nuxt": "^15.0.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-format": "^2.0.1",
    "knip": "^6.43.0",
    "nuxt": "^4.6.2",
    "nuxt-security": "^2.7.0",
    "stylelint": "^17.16.0",
    "tailwind-csstree": "^0.4.1",
    "tailwindcss": "^4.3.3",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "unplugin-fonts": "^2.1.0",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
